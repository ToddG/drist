set -u


# ---[ GLOBALS ]--------------------------------------------------
PRIVILEGES_BIN=""             # binary to run privileged command, e.g. [doas | sudo]
EXEC='exec sh -c'             # posix compliant shell.
SSHONCE=0                     # set up a socket for persistent connection.
TRUNCATE=0                    # Remove the domain name from the hostname.
USE_FILE="script"             # default script file to upload if no optional switches.
USE_DIR="files"               # default directory to upload if no optional switches.
SSH_PARAMS=""                 # default ssh parameters.
COPY_FILE=""                  # default single file to copy.
TEMPDIR=""                    # assigned to in the create_temp() function
COPY_ROOT_DIR='$HOME'         # root directory to copy files to, defaults to $HOME
COPIED_FILE=""                # file copied to $COPY_ROOT_DIR/filename
COPIED_DIR=""                 # dir copied to $COPY_ROOT_DIR/directory
DELETE_COPIED_FILES=false     # delete the copied files/directories
DELETE_DRIST_DIR=true         # delete the .drist_XXXXX temp dir
INVOKE_REMOTE_SCRIPT=true     # invoke the script on the remote server
COPY_DRIST_DIR=true           # copy the file/directory from the remote temp dir to the remote copy_root_dir


# ---[ LOGGING ]--------------------------------------------------
DEFAULT_MSG=""
DEFAULT_CMD=""
DEFAULT_OUTPUT=""

# default global log level is info
GLOBAL_LOG_LEVEL=2

TRACE_LOG_LEVEL=0
DEBUG_LOG_LEVEL=1
INFO_LOG_LEVEL=2
WARN_LOG_LEVEL=3
ERROR_LOG_LEVEL=4

CLIENT=$(hostname)

update_log_level(){
  LEVEL=$1
  case $LEVEL in
    "trace")                    # trace log level
        GLOBAL_LOG_LEVEL=$TRACE_LOG_LEVEL
    ;;
    "debug")                    # debug log level
        GLOBAL_LOG_LEVEL=$DEBUG_LOG_LEVEL
    ;;
    "info")                     # info log level
        GLOBAL_LOG_LEVEL=$INFO_LOG_LEVEL
    ;;
    "warn")                     # warning log level
        GLOBAL_LOG_LEVEL=$WARN_LOG_LEVEL
    ;;
    "warning")                  # warning log level
        GLOBAL_LOG_LEVEL=$WARN_LOG_LEVEL
    ;;
    "error")                    # error log level
        GLOBAL_LOG_LEVEL=$ERROR_LOG_LEVEL
    ;;
    "*")                        # unknown log level
        echo "UKNOWN LOG LEVEL, DEFAULTING TO INFO"
        GLOBAL_LOG_LEVEL=$INFO_LOG_LEVEL
    ;;
  esac
}

log_level_name(){
  LEVEL=$1
  case $LEVEL in
    0)
      CURRENT_LOG_LEVEL_NAME="TRACE"
    ;;
    1)
      CURRENT_LOG_LEVEL_NAME="DEBUG"
    ;;
    2)
      CURRENT_LOG_LEVEL_NAME="INFO"
    ;;
    3)
      CURRENT_LOG_LEVEL_NAME="WARN"
    ;;
    4)
      CURRENT_LOG_LEVEL_NAME="ERROR"
    ;;
   *)
      CURRENT_LOG_LEVEL_NAME="UNKNOWN"
    ;;
  esac
}

# echo a log message with details depending on value
# of GLOBAL_LOG_LEVEL 0-5 (trace|debug|info|warn|error)
log(){
  # -----------------------------
  # params
  # -----------------------------
  LEVEL=$1
  TOPIC=$2
  MSG="${3:-$DEFAULT_MSG}"
  CMD="${4:-$DEFAULT_CMD}"
  OUTPUT="${5:-$DEFAULT_OUTPUT}"
  # -----------------------------
  # invariants
  # -----------------------------
  if [ -z "$LEVEL" ]; then
    echo "log failed, LEVEL not set or is blank"
  fi
  if [ -z "$TOPIC" ]; then
    echo "log failed, TOPIC not set or is blank"
  fi
  if [ -z "$MSG" ]; then
    echo "log failed, MSG not set or is blank"
  fi

  if [ $LEVEL -ge $GLOBAL_LOG_LEVEL ]; then
      log_level_name $LEVEL
      case $LEVEL in
          0 | 1 | 2)
              case $GLOBAL_LOG_LEVEL in
                  0)
                    echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG:$CMD:$OUTPUT"
                  ;;
                  1)
                    echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG:$CMD"
                  ;;
                  2)
                    echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG"
                  ;;
                  *)
                    echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG"
                  ;;
              esac
          ;;
          3)
            echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG:$CMD:$OUTPUT"
          ;;
          4)
            echo "[$CLIENT $(date '+%Y-%m-%d %H:%M:%S')][$CURRENT_LOG_LEVEL_NAME]:$TOPIC:$MSG:$CMD:$OUTPUT"
          ;;
          *)
          ;;
    esac
  fi
}

trace(){
  # -----------------------------
  # params
  # -----------------------------
  TOPIC=$1
  MSG="${2:-$DEFAULT_MSG}"
  CMD="${3:-$DEFAULT_CMD}"
  OUTPUT="${@:-$DEFAULT_OUTPUT}"
  # -----------------------------
  # invariants
  # -----------------------------
  if [ -z "$TOPIC" ]; then
    echo "trace failed, TOPIC not set or is blank"
  fi
  if [ -z "$MSG" ]; then
    echo "trace failed, MSG not set or is blank"
  fi

  log $TRACE_LOG_LEVEL "$TOPIC" "$MSG" "$CMD" "$OUTPUT"
}

