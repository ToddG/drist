##
# usage --
# @brief displays usage information.
usage() {
    echo "$0 v3.0.0"
    echo "$0 [-h| -help] [-v] [-vv] [-th] [-nc] [-crd] [-ps] [-dcf] [-sf] [-ud] [-uf] [-si] [-ndd] [-ep [sudo|doas|...]] destination [...]"
    echo "$0 -h   | --help                     : display this help message"
    echo "$0 -ll  | --log-level                : configure log level [trace|debug|info|warn|error]"
    echo "$0 -th  | --truncate-hostname        : truncate hostname"
    echo "$0 -nc  | --no-copy-drist-dir        : do not copy the temp .drist_XXX dir"
    echo "$0 -crd | --copy-root-dir            : root directory to copy the temp .drist_XXX dir to"
    echo "$0 -ps  | --persistent-ssh           : configure ssh connection to be persistent"
    echo "$0 -dcf | --delete-copied-files      : delete copied files from the copy root dir when script finishes"
    echo "$0 -sf  | --script-file              : script file to run"
    echo "$0 -ud  | --upload-dir               : directory to upload to remote server"
    echo "$0 -uf  | --upload-file              : file to upload to remote server"
    echo "$0 -si  | --skip-invoke              : skip invoking remote script (dry-run)"
    echo "$0 -ndd | --no-delete-drist-dir      : do NOT delete remote temp .drist_XXX dir (debugging)"
    echo "$0 -ep  | --elevate-permissions      : elevate permissions using [sudo|doas|...]"
    exit 0
}

##
# copy_files --
# @brief Copy files from a local directory to a remote server.
#
# Parameters:
#   $1 - source directory (e.g. /local/path/to/upload/directory)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
copy_files() {
    src_dir=$1
    remote_server=$2
    remote_tmp=$3

    info "copy_files" "$CLIENT:$src_dir -> $remote_server:$remote_tmp"
    
    if [ -d "${src_dir}" ]; then
        if [ -z "${remote_server}" ]; then
            error "copy_files" "remote_server is blank, exiting"
        fi
        if [ -z "${remote_tmp}" ]; then
            error "copy_files" "remote_tmp is blank, exiting"
        fi
            
        # basename of source dir (e.g. files-server.local from /local/path/to/upload/directory)
        src_base=$(basename -- "${src_dir}")

        # global var used to delete the copied directory
        COPIED_DIR="${src_base}"

        # Copy files to remote host.
        tar cf - -C "$(dirname -- ${src_dir})" -- "${src_base}" | ssh $SSH_PARAMS "${remote_server}" 'tar xf - -C '"${remote_tmp}"
        debug "copy_files" "copied $CLIENT:$src_dir -> $remote_server:$remote_tmp"

        if [ "$COPY_DRIST_DIR" = "true" ]; then
            # copy files from remote_tmp directory to the copy_root_dir
            ssh $SSH_PARAMS "${remote_server}" "tar cf - -C \"${remote_tmp}\" . | ${PRIVILEGES_BIN} tar xf - -C \"$COPY_ROOT_DIR\""
            debug "copy_files" "copied $remote_server:$remote_tmp -> $remote_server:$remote_tmp/$COPY_ROOT_DIR" "PRIVILEGES_BIN: $PRIVILEGES_BIN"
        fi
    fi
}

##
# copy_single_file --
# @brief Copy a single file from a local directory to a remote server.
#
# Parameters:
#   $1 - source file (e.g. /local/path/to/upload.file)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
#
# NOTE: Even in the case when a single file is copied to remote host
#       if a file/directory is labeled with the 'HOSTNAME' string in
#       the same directory as the single file, it will be copied as
#       well.
copy_single_file() {
    src_file=$1
    remote_server=$2
    remote_tmp=$3

    info "copy_single_file" "$CLIENT:$src_file ->$remote_server:$remote_tmp"

    if [ -f "${src_file}" ]; then
        if [ -z "${remote_server}" ]; then
            error "copy_single_file" "remote_server is blank, exiting"
        fi
        if [ -z "${remote_tmp}" ]; then
            error "copy_single_file" "remote_tmp is blank, exiting"
        fi
            
        # Get the current working directory.
        file_name=$(basename -- "$src_file")

        # global used to delete the file
        COPIED_FILE="${file_name}"

        # copy file to remote host.
        tar cf - -C "$(dirname -- "$src_file")" "./${file_name}" | ssh $SSH_PARAMS "${remote_server}" 'tar xf - -C '"${remote_tmp}"
        debug "copy_single_file" "copied $src_dir/$file_name -> $remote_server/$remote_tmp"

        # copy files from remote_tmp directory to the copy_root_dir
        if [ "$COPY_DRIST_DIR" = "true" ]; then
            ssh $SSH_PARAMS "${remote_server}" "tar cf - -C \"$remote_tmp\" . | ${PRIVILEGES_BIN} tar xf - -C \"$COPY_ROOT_DIR\""
            debug "copy_single_file" "copied $remote_server:$remote_tmp -> $remote_server:$remote_tmp/$COPY_ROOT_DIR" "COPY_ROOT_DIR: $COPY_ROOT_DIR, COPIED_FILE: $COPIED_FILE PRIVILEGES_BIN: $PRIVILEGES_BIN"
        fi
    fi
}

##
# remote_script --
# @brief Executes script on remote host.
#
# Parameters:
#   $1 - script file (e.g. /local/path/to/script/to/invoke/on/remote/server)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
remote_script() {
    script_file=$1
    remote_server=$2
    remote_tmp=$3

    info "remote_script" "starting" "script_file: $script_file, remote_server: $remote_server, remote_temp: $remote_tmp, EXEC: $EXEC, PRIVILEGES_BIN=$PRIVILEGES_BIN"

    if [ -f "${script_file}" ]; then
        if [ -z "${remote_server}" ]; then
            error "remote_script" "remote_server is blank, exiting"
        fi
        if [ -z "${remote_tmp}" ]; then
            error "remote_script" "remote_tmp is blank, exiting"
        fi
            
        file_name=$(basename ${script_file})
        ssh $SSH_PARAMS "${remote_server}" "cd ${remote_tmp} && \
            cat - > ${remote_tmp}/${file_name} && \
            chmod u+x ${remote_tmp}/${file_name} && \
            ${EXEC} ${remote_tmp}/${file_name}" < "$script_file"
    fi
    info "remote_script" "completed" "script_file: $script_file, remote_server: $remote_server, remote_temp: $remote_tmp, EXEC: $EXEC, PRIVILEGES_BIN=$PRIVILEGES_BIN"
}

##
# delete_on_exit --
# @brief Delete copied file and/or directory on exit.
#
# Parameters:
delete_copied_files() {
    remote_server=$1
    info "delete_copied_files" "remote_server: $remote_server" 
    if [ "$DELETE_COPIED_FILES" = "true" ]; then
        if [ -n "$COPIED_FILE" ]; then
            ssh $SSH_PARAMS "${remote_server}" "${EXEC} rm $COPY_ROOT_DIR/$COPIED_FILE"
            debug "delete_copied_files" "deleted file: $remote_server:$COPY_ROOT_DIR/$COPIED_FILE" "delete_copied_files: $DELETE_COPIED_FILES, copy_root_dir: $COPY_ROOT_DIR, copied_file: $COPIED_FILE, copied_dir: $COPIED_DIR, EXEC: $EXEC"
        fi
        if [ -n "$COPIED_DIR" ]; then
            ssh $SSH_PARAMS "${remote_server}" "${EXEC} rm -rf $COPY_ROOT_DIR/$COPIED_DIR"
            debug "delete_copied_files" "deleted dir: $remote_server:$COPY_ROOT_DIR/$COPIED_DIR" "delete_copied_files: $DELETE_COPIED_FILES, copy_root_dir: $COPY_ROOT_DIR, copied_file: $COPIED_FILE, copied_dir: $COPIED_DIR, EXEC: $EXEC"
        fi
    fi
}


##
# create_temp --
# @brief Creates temporary directory on remote host.
#
# Parameters:
#   $1 - remote server name (e.g. server)
#
# NOTE: assigns value to global var
create_temp() {
    remote_server=$1

    info "create_temp" "remote_server: $remote_server"
    
    if [ -z "${remote_server}" ]; then
        error "create_temp" "remote_server is blank, exiting"
    fi
    TEMPDIR=$(ssh $SSH_PARAMS "${remote_server}" "mktemp -d ~/.drist_files_XXXXXXXXXXXXXXX")
    if [ -z "$TEMPDIR" ]; then
        error "create_temp" "mktemp error, TEMPDIR is not set, aborting"
    fi
    info "create_temp" "created temp dir: ${remote_server}:$TEMPDIR"
}

##
# delete_temp --
# @brief Deletes temporary directory on remote host.
#
# Parameters:
#   $1 - remote server name (e.g. server)
#   $2 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
delete_temp() {
    remote_server=$1
    remote_tmp=$2

    info "delete_temp" "delete $remote_server:$remote_tmp"

    if [ -z "${remote_server}" ]; then
        error "delete_temp" "remote_server is blank, exiting"
    fi
    if [ -z "${remote_tmp}" ]; then
        error "delete_temp" "remote_tmp is blank, exiting"
    fi
    if echo "${remote_tmp}" | grep drist_files_ >/dev/null ; then
        ssh $SSH_PARAMS "$remote_server" "rm -fr ${remote_tmp}"
        debug "delete_temp" "deleted $remote_server:$remote_tmp" "SSH_PARAMS:$SSH_PARAMS"
    else
        error "delete_temp" "temp dir was reset during execution, current value is = $remote_tmp"
    fi
}


# ---[ ARGUMENT PARSER ]------------------------------------------
# (custom getopt() like argument parser)

# check to see if we have enough arguments.
if [ $# -lt 1 ]; then echo "Not enough arguments."; fi

# flag to set when done processing arguments.
done_options=

##
# @brief check to see if there are more arguments to parse.
#
# @return 1 if done 0 if more args.
more_options() {
    test $done_options && return 1
    [ $# -eq 0 ] && return 1
    case "$1" in
        --) return 1 ;;   # stop options
        -*) return 0 ;;
        *) return 1 ;;
    esac
}

# parse arguments.
while more_options "$1"
do
    case "$1" in
        --)
            done_options=1
            shift
            break
            ;;
        "-h"|"--help")
            usage
            ;;
        "-ll"|"--log-level")
            [ $# -gt 1 ] || usage "-ll requires a log level [trace|debug|info|warn|error]"
            shift
            update_log_level $1
            ;;
        "-vv"|"--very-verbose-logging")
            set -x
            ;;
        "-th"|"--truncate-hostname")
            TRUNCATE=1
            ;;
        "-nc"|"--no-copy-drist-dir")
            # do not copy the temp .drist dir to a separate directory
            COPY_DRIST_DIR=false
            ;;
        "-crd"|"--copy-root-directory")
            [ $# -gt 1 ] || usage "-crd requires a root directory to copy files to"
            shift
            old_copy_root_dir="$COPY_ROOT_DIR"
            COPY_ROOT_DIR="$1"
            debug "runtime" "COPY_ROOT_DIR changed from default $old_copy_root_dir to $COPY_ROOT_DIR"
            ;;
        "-ps"|"--persistent-ssh")
            SSHONCE=1
            ;;
        "-dcf"|"--delete-copied-files")
            # delete copied files when script finishes
            DELETE_COPIED_FILES=true
            ;;
        "-sf"|"--script-file")
            # script file to run
            [ $# -gt 1 ] || usage "-sf requires a script name"
            shift
            USE_FILE="$1"
            ;;
        "-ud"|"--upload-dir")
            # directory of files to upload
            [ $# -gt 1 ] || usage "-ud requires a directory location"
            shift
            USE_DIR="$1"
            ;;
        "-uf"|"--upload-file")
            # file to upload
            [ $# -gt 1 ] || usage "-uf requires a file name"
            shift
            COPY_FILE="$1"
            ;;
        "-si"|"--skip-invoke")
            # skip invoking the remote script, useful for debugging scripts
            INVOKE_REMOTE_SCRIPT=false
            ;;
        "-ndd"|"--no-delete-drist-dir")
            # don't delete the temp .drist dir, useful for debugging scripts
            DELETE_DRIST_DIR=false
            ;;
        "-ep"|"--elevate-permissions")                                            # elevate permissions.
            [ $# -gt 1 ] || usage "-ep requires an elevation tool [sudo|doas]"
            shift
            PRIVILEGES_BIN="$1"
            EXEC="$PRIVILEGES_BIN sh -c "
            ;;
        -*)
            usage "unknown option $1"
            ;;
    esac
    shift
done

# ---[ RUNTIME ]--------------------------------------------------
debug "runtime" "EXEC: $EXEC, PRIVILEGES_BIN: $PRIVILEGES_BIN"

# use ControlMaster to make connections persistent
if [ $SSHONCE -eq 1 ]; then
   SSH_PARAMS='-o ControlMaster=auto -o ControlPath=/tmp/drist_ssh_%h_%p_%r.sock -o ControlPersist=1m'
   debug "runtime" "ssh_params: $SSH_PARAMS"
fi

# start looping over server list
if [ -f "$1" ]; then
    SERVER_LIST="$(tr '\n' ' ' < $1)"
else
    SERVER_LIST="$@"
fi
debug "runtime" "server_list: $SERVER_LIST"

if [ "${SERVER_LIST}" = "" ]; then
    error "runtime" "No server specified"
fi

for remote_server in ${SERVER_LIST}
do

  debug "runtime" "processing server: $remote_server"
  # check if host exists
  HOSTNAME=$(ssh $SSH_PARAMS "$remote_server" "uname -n")
  if [ "$?" -ne 0 ]; then
      error "ssh failed ${remote_server}"
  fi

  if [ "$TRUNCATE" -eq 1 ]; then
      HOSTNAME="${HOSTNAME%%.*}"
  fi

  # assigns value to TEMPDIR
  create_temp "${remote_server}"
  copy_files "${USE_DIR}" "${remote_server}" "$TEMPDIR"
  copy_files "${USE_DIR}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  copy_single_file "${COPY_FILE}" "${remote_server}" "$TEMPDIR"
  copy_single_file "${COPY_FILE}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  if [ "$INVOKE_REMOTE_SCRIPT" = "true" ]; then
      remote_script "${USE_FILE}" "${remote_server}" "$TEMPDIR"
      remote_script "${USE_FILE}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  fi
  if [ "$DELETE_DRIST_DIR" = "true" ]; then
      delete_temp "${remote_server}" "$TEMPDIR"
  fi
  if [ "$DELETE_COPIED_FILES" = "true" ]  && [ "$COPY_DRIST_DIR" = false ]; then
    delete_copied_files "${remote_server}"
  fi

  # close socket if persistence is active
  if [ "$SSHONCE" -eq 1 ]; then
      ssh $SSH_PARAMS -O exit -N "$1"
  fi

  unset TEMPDIR HOSTNAME
done
